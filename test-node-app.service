[Unit]
Description=Test Node App
After=network.target

[Service]
Type=simple
# Change these two paths/user to match your server
User=ubuntu
WorkingDirectory=/home/ubuntu/test-node-app
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
